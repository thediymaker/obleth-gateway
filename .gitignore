# =============================================================
# Build output & dependencies
# =============================================================

# ---- Rust ----
**/target/
**/*.rs.bk
*.pdb

# ---- Node / Next.js ----
node_modules/
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Python (compressor sidecar) ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# =============================================================
# Secrets & per-machine configuration
# =============================================================

# ---- env / secrets ----
.env
.env.*
!.env.example

# ---- local compose overrides (may contain cluster node IPs) ----
docker-compose.override.yml
docker-compose.override.yaml
deploy/docker/docker-compose.override.yml

# =============================================================
# Runtime & local artifacts
# =============================================================

# ---- telemetry WAL ----
*.wal
*.wal.segments/
/obleth-telemetry.wal

# ---- bench harness state ----
/bench/*.log
/bench/.keys.json
/bench/.run-meta.json
/bench/.fairshare-samples.jsonl

# =============================================================
# Local-only tooling, planning & scratch
# =============================================================

/plan.md
/asset-tools
# Nothing under the top-level docs/ is committed: documentation lives in the
# obleth-docs site. Local specs, plans, and review notes stay on this machine.
# Anchored with a leading slash so it cannot swallow nested dirs such as
# control-plane/lib/charo/docs/.
/docs/
.agents
.claude
.codex
.superpowers

# =============================================================
# Editor / OS
# =============================================================

.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
