---
name: DeepSeek-V4.1-Flash on vLLM
description: "DeepSeek's V4.1 Flash with its routed experts in CPU memory (UVA offload), after vLLM's H100 and GB300 recipes. Needs a vLLM built from main: no release supports it yet. Not yet run."
engine: vllm
kind: model
model: deepseek-ai/DeepSeek-V4.1-Flash
weights_gb: 510
requires: "vLLM built from main (vllm-project/vllm#56228); 0.30.0 is unreleased"
model_type: chat
api_model_name: deepseek-v4.1-flash
port: 8000
health_path: /health
target_replicas: 1
max_job_failures: 2
env:
  VLLM_ENGINE_READY_TIMEOUT_S: "3600"
  VLLM_USE_V2_MODEL_RUNNER: "1"
  PYTORCH_CUDA_ALLOC_CONF: expandable_segments:True
inputs:
  - name: context
    label: Context length
    type: choice
    options: [65536, 131072, 262144, 1048576]
    default: 131072
  - name: image
    label: Container image
    type: path
    default: "{{cluster.image.vllm}}"
    required: true
  - name: cache
    label: Weight cache
    type: path
    default: "{{cluster.cache}}"
    required: true
    help: HF_HOME. 510 GB is downloaded on the first start.
  - name: tools
    label: Tool calling
    type: flag
    default: true
    adds: --enable-auto-tool-choice --tool-call-parser deepseek_v41
---
#!/bin/bash -l
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=72
#SBATCH --mem=0
set -euo pipefail
{{cluster.setup}}
export HF_HOME={{cache}}
# About 240 GiB of the routed experts wait in CPU memory; the rest fits a 96 GB GPU.
apptainer exec --nv --bind {{cache}} {{image}} \
  vllm serve deepseek-ai/DeepSeek-V4.1-Flash \
    --served-model-name deepseek-v4.1-flash \
    --host 0.0.0.0 --port "$OBLETH_SERVING_PORT" \
    --tokenizer-mode deepseek_v41 \
    --reasoning-parser deepseek_v41 {{tools}} \
    --language-model-only \
    --engram-config '{"cpu_offload":true}' \
    --offload-backend uva --cpu-offload-gb 240 \
    --cpu-offload-params routed_experts.w13_weight routed_experts.w2_weight \
    --max-model-len {{context}} \
    --max-num-batched-tokens 4096 \
    --gpu-memory-utilization 0.92
