---
name: gpt-oss-20b
description: "OpenAI's smaller open-weight reasoning model, 21B parameters with 3.6B active, in MXFP4. Runs on one GPU with 24 GB or more and answers quickly. Reasoning effort is set per request."
engine: vllm
kind: model
model: openai/gpt-oss-20b
weights_gb: 14
requires: "vLLM 0.10.1 or later"
model_type: chat
api_model_name: gpt-oss-20b
port: 8000
health_path: /health
target_replicas: 1
max_job_failures: 2
env:
  VLLM_ENGINE_READY_TIMEOUT_S: "3600"
tested:
  - hardware: "1× A100 80 GB"
    engine: "vLLM 0.30.1rc1 (nightly)"
    date: 2026-10-03
    result: "Ready in 2.5 minutes. One request ran at about 150 tokens a second; 16 at once reached 2,030. Tool calls worked."
inputs:
  - name: context
    label: Context length
    type: choice
    options: [32768, 65536, 131072]
    default: 131072
  - name: tools
    label: Tool calling
    type: flag
    default: true
    adds: --enable-auto-tool-choice --tool-call-parser openai
  - name: image
    label: Container image
    type: path
    default: "{{cluster.image.vllm}}"
    required: true
  - name: cache
    label: Weight cache
    type: path
    default: "{{cluster.cache}}"
    required: true
    help: HF_HOME, where the weights are kept between jobs.
---
#!/bin/bash -l
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
set -euo pipefail
{{cluster.setup}}
export HF_HOME={{cache}}
apptainer exec --nv --bind {{cache}} {{image}} \
  vllm serve openai/gpt-oss-20b \
    --served-model-name {{api_model_name}} \
    --host 0.0.0.0 --port "$OBLETH_SERVING_PORT" \
    --max-model-len {{context}} \
    {{tools}}
