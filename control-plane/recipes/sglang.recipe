---
name: SGLang
description: "Any Hugging Face model SGLang supports, from its safetensors. Tensor-parallel across the GPUs the job gets on one node."
engine: sglang
kind: engine
requires: "An SGLang image that supports the model's architecture"
model_type: chat
api_model_name: my-model
port: 8000
health_path: /health
target_replicas: 1
max_job_failures: 2
tested:
  - hardware: "1× A100 80 GB"
    engine: "SGLang 0.5.21"
    date: 2026-10-03
    result: "Served openai/gpt-oss-20b with --tool-call-parser gpt-oss --reasoning-parser gpt-oss. Ready in 8.5 minutes. One request ran at about 125 tokens a second; 16 at once reached 430. Tool calls worked 3 times out of 3."
  - hardware: "1× GH200 96 GB"
    engine: "SGLang 0.5.21 (Arm)"
    date: 2026-10-03
    result: "Served openai/gpt-oss-20b with --tool-call-parser gpt-oss --reasoning-parser gpt-oss --attention-backend triton, since the Arm image lacks FlashAttention 3. Ready in 4 minutes. One request ran at about 245 tokens a second; 16 at once reached 985. Tool calls worked 3 times out of 3."
inputs:
  - name: model
    label: Hugging Face model
    type: text
    required: true
    help: The repo id, e.g. Qwen/Qwen3-32B.
  - name: context
    label: Context length
    type: number
    min: 1024
    help: Leave empty for the model's own maximum.
  - name: image
    label: Container image
    type: path
    default: "{{cluster.image.sglang}}"
    required: true
  - name: cache
    label: Weight cache
    type: path
    default: "{{cluster.cache}}"
    required: true
  - name: extra
    label: More SGLang flags
    type: text
    help: "Anything else for sglang.launch_server, e.g. --tool-call-parser qwen25. With the official Arm image, add --attention-backend triton: it has no FlashAttention 3 kernels."
---
#!/bin/bash -l
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
set -euo pipefail
{{cluster.setup}}
export HF_HOME={{cache}}
CONTEXT="{{context}}"
apptainer exec --nv --bind {{cache}} {{image}} \
  python3 -m sglang.launch_server \
    --model-path {{model}} \
    --served-model-name {{api_model_name}} \
    --host 0.0.0.0 --port "$OBLETH_SERVING_PORT" \
    --tp "${SLURM_GPUS_ON_NODE:-1}" \
    ${CONTEXT:+--context-length "$CONTEXT"} \
    {{extra}}
