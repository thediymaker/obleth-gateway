---
name: SGLang
description: "Any Hugging Face model SGLang supports, from its safetensors. Tensor-parallel across the GPUs the job gets on one node."
engine: sglang
kind: engine
requires: "An SGLang image that supports the model's architecture"
model_type: chat
api_model_name: my-model
port: 8000
health_path: /health
target_replicas: 1
max_job_failures: 2
inputs:
  - name: model
    label: Hugging Face model
    type: text
    required: true
    help: The repo id, e.g. Qwen/Qwen3-32B.
  - name: context
    label: Context length
    type: number
    min: 1024
    help: Leave empty for the model's own maximum.
  - name: image
    label: Container image
    type: path
    default: "{{cluster.image.sglang}}"
    required: true
  - name: cache
    label: Weight cache
    type: path
    default: "{{cluster.cache}}"
    required: true
  - name: extra
    label: More SGLang flags
    type: text
    help: Anything else for sglang.launch_server, e.g. --tool-call-parser qwen25.
---
#!/bin/bash -l
#SBATCH --gres=gpu:1
set -euo pipefail
{{cluster.setup}}
export HF_HOME={{cache}}
CONTEXT="{{context}}"
apptainer exec --nv --bind {{cache}} {{image}} \
  python3 -m sglang.launch_server \
    --model-path {{model}} \
    --served-model-name {{api_model_name}} \
    --host 0.0.0.0 --port "$OBLETH_SERVING_PORT" \
    --tp "${SLURM_GPUS_ON_NODE:-1}" \
    ${CONTEXT:+--context-length "$CONTEXT"} \
    {{extra}}
