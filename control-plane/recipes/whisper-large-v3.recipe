---
name: Whisper large-v3
description: "OpenAI's speech recognition model, served on the transcriptions endpoint. Small: any GPU with 8 GB or more."
engine: vllm
kind: model
model: openai/whisper-large-v3
weights_gb: 3
requires: "vLLM 0.7.0 or later"
model_type: audio_transcription
api_model_name: whisper-large-v3
port: 8000
health_path: /health
target_replicas: 1
max_job_failures: 2
tested:
  - hardware: an A100 20 GB slice
    engine: "vLLM 0.30.1rc1 (nightly)"
    date: 2026-10-03
    result: "Ready in 3 minutes. Transcribed an 11-second clip correctly in 1.5 seconds."
inputs:
  - name: image
    label: Container image
    type: path
    default: "{{cluster.image.vllm}}"
    required: true
  - name: cache
    label: Weight cache
    type: path
    default: "{{cluster.cache}}"
    required: true
    help: HF_HOME, where the weights are kept between jobs.
---
#!/bin/bash -l
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
set -euo pipefail
{{cluster.setup}}
export HF_HOME={{cache}}
apptainer exec --nv --bind {{cache}} {{image}} \
  vllm serve openai/whisper-large-v3 \
    --served-model-name {{api_model_name}} \
    --host 0.0.0.0 --port "$OBLETH_SERVING_PORT"
