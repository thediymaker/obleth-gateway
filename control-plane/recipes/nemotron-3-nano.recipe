---
name: Nemotron 3 Nano 30B-A3B (FP8)
description: "NVIDIA's small hybrid Mamba and mixture-of-experts model, 30B parameters with 3B active, in FP8. Fast, with tool calling and reasoning. One GPU with 48 GB or more; FP8 runs natively on Hopper and newer."
engine: vllm
kind: model
model: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8
weights_gb: 33
requires: "vLLM 0.17.0 or later"
model_type: chat
api_model_name: nemotron-3-nano
port: 8000
health_path: /health
target_replicas: 1
max_job_failures: 2
env:
  # The first start downloads the weights; don't let vLLM give up while it loads.
  VLLM_ENGINE_READY_TIMEOUT_S: "3600"
tested:
  - hardware: "1× H100 80 GB"
    engine: "vLLM 0.30.1rc1 (nightly)"
    date: 2026-10-03
    result: "Ready in 5 minutes. One request ran at about 300 tokens a second; 16 at once reached 1,900. Tool calls worked 3 times out of 3."
  - hardware: "1× A100 80 GB"
    engine: "vLLM 0.30.1rc1 (nightly)"
    date: 2026-10-03
    result: "Ready in 4.5 minutes (FP8 runs as 8-bit weights on this older GPU). One request ran at about 210 tokens a second; 16 at once reached 1,190. Tool calls worked 3 times out of 3."
inputs:
  - name: context
    label: Context length
    type: choice
    options: [32768, 131072, 262144]
    default: 131072
    unit: tokens
  - name: tools
    label: Tool calling
    type: flag
    default: true
    adds: --enable-auto-tool-choice --tool-call-parser qwen3_coder
    capabilities: [function_calling, tool_choice]
  - name: reasoning
    label: Reasoning
    type: flag
    default: true
    adds: --reasoning-parser nemotron_v3
  - name: extra
    label: More vLLM flags
    type: text
    help: "Anything else to pass to vllm serve, written as on its command line, such as --gpu-memory-utilization 0.85 on a GPU shared with other work."
  - name: image
    label: Container image
    type: path
    default: "{{cluster.image.vllm}}"
    help: The image the server runs in. Leave it empty to run vllm from the node's PATH, for example after the cluster's setup lines load it.
  - name: cache
    label: Weight cache
    type: path
    default: "{{cluster.cache}}"
    required: true
    help: Where the weights are kept between jobs. Use shared storage, so a restart on another node doesn't download them again.
---
#!/bin/bash -l
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
# The cluster's setup lines run before strict mode, since site scripts often
# read unset variables.
{{cluster.setup}}
set -euo pipefail
export HF_HOME="{{cache}}"
# In the image when one is set, with the cluster's container command
# (OBLETH_CONTAINER_RUN, "apptainer exec --nv" when unset); else from the node's PATH.
IMAGE="{{image}}"
RUN=()
if [ -n "$IMAGE" ]; then
  read -r -a RUN <<< "${OBLETH_CONTAINER_RUN:-apptainer exec --nv}"
  RUN+=(--bind "$HF_HOME" "$IMAGE")
fi
exec ${RUN[@]+"${RUN[@]}"} vllm serve nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8 \
  --served-model-name {{api_model_name}} \
  --host 0.0.0.0 --port "$OBLETH_SERVING_PORT" \
  --tensor-parallel-size "${SLURM_GPUS_ON_NODE:-1}" \
  --trust-remote-code --async-scheduling \
  --kv-cache-dtype fp8 \
  --max-model-len {{context}} \
  {{tools}} {{reasoning}} {{extra}}
