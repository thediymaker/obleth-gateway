---
name: Ollama
description: "Any model in the Ollama library, pulled when the job starts and kept in the cache. Quick to try."
engine: ollama
kind: engine
requires: "The official Ollama image, or ollama on the node's PATH"
model_type: chat
api_model_name: my-model
port: 8000
health_path: /api/tags
target_replicas: 1
max_job_failures: 2
tested:
  - hardware: "1× A100 80 GB"
    engine: "Ollama 0.35.1"
    date: 2026-10-03
    result: "Served gpt-oss:20b. Ready in 2.5 minutes. The first answer took over a minute while Ollama loaded the model; after that, about 47 tokens a second. Tool calls worked 3 times out of 3."
inputs:
  - name: model
    label: Ollama model
    type: text
    required: true
    help: The Ollama tag, such as qwen2.5:0.5b, or hf.co/ followed by a GGUF repo and quantization. It is served under the deployment's name.
  - name: context
    label: Context length
    type: number
    min: 1024
    default: 32768
    required: true
    unit: tokens
    help: The longest prompt and answer together, per request. Longer contexts and more requests at once need more GPU memory.
  - name: parallel
    label: Requests at once
    type: number
    min: 1
    max: 64
    default: 4
  - name: tools
    label: Tool calling
    type: flag
    default: true
    adds: ""
    capabilities: [function_calling, tool_choice]
    help: Marks the model for tool calls. Turn it off for a model whose Ollama template has no tools, since Ollama refuses tool requests to it.
  - name: image
    label: Container image
    type: path
    default: "{{cluster.image.ollama}}"
    help: The image the server runs in. Leave it empty to run ollama from the node's PATH, for example after the cluster's setup lines load it.
  - name: cache
    label: Weight cache
    type: path
    default: "{{cluster.cache}}"
    required: true
    help: Where pulled models are kept between jobs, in an ollama folder inside it. Use shared storage, so a restart on another node doesn't pull them again.
---
#!/bin/bash -l
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
# The cluster's setup lines run before strict mode, since site scripts often
# read unset variables.
{{cluster.setup}}
set -euo pipefail
export OLLAMA_MODELS="{{cache}}/ollama"
IMAGE="{{image}}"
CONTAINER=()
if [ -n "$IMAGE" ]; then read -r -a CONTAINER <<< "${OBLETH_CONTAINER_RUN:-apptainer exec --nv}"; fi
# Ollama reads its settings from the environment. In a container the image's
# own variables win over the job's, so there they are passed with --env.
# The model stays loaded (keep-alive -1) so a quiet spell doesn't unload it.
ollama_cmd() { # host:port; sets CMD to an ollama command for that server
  local vars="OLLAMA_MODELS=$OLLAMA_MODELS,OLLAMA_HOST=$1,OLLAMA_KEEP_ALIVE=-1,OLLAMA_CONTEXT_LENGTH={{context}},OLLAMA_NUM_PARALLEL={{parallel}}"
  if [ -n "$IMAGE" ]; then
    CMD=("${CONTAINER[@]}" --bind "{{cache}}" --env "$vars" "$IMAGE" ollama)
  else
    local env_vars
    IFS=, read -r -a env_vars <<< "$vars"
    CMD=(env "${env_vars[@]}" ollama)
  fi
}
# Pull through a server only this node can reach, then serve on the replica's
# port: the health check passes once the model is there to answer.
for ((PULL_PORT = 49152 + RANDOM % 10000; ; PULL_PORT++)); do (exec 3<>/dev/tcp/127.0.0.1/$PULL_PORT) 2>/dev/null || break; done
ollama_cmd "127.0.0.1:$PULL_PORT"
"${CMD[@]}" serve &
PULLER=$!
until "${CMD[@]}" list >/dev/null 2>&1; do kill -0 $PULLER; sleep 2; done
# Pull only when the model isn't in the cache, so a restart works without
# reaching the registry.
"${CMD[@]}" show {{model}} >/dev/null 2>&1 || "${CMD[@]}" pull {{model}}
# Serve it under the deployment's name too, which is what clients send.
[ "{{model}}" = "{{api_model_name}}" ] || "${CMD[@]}" cp {{model}} {{api_model_name}}
pkill -TERM -P $PULLER || true; kill $PULLER 2>/dev/null || true; wait $PULLER || true
ollama_cmd "0.0.0.0:$OBLETH_SERVING_PORT"
exec "${CMD[@]}" serve
