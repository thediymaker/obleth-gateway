---
name: GLM-5.2 on Grace Hopper (llama.cpp)
description: "GLM-5.2 as a 2-bit GGUF with llama-server on one GH200, MoE experts in Grace memory, 4 requests at once."
engine: llamacpp
kind: model
model: unsloth/GLM-5.2-GGUF:UD-IQ2_M
requires: "llama-server built for arm64 + CUDA (a native build is the most reliable on GH200)"
model_type: chat
api_model_name: glm-5.2
port: 8000
target_replicas: 2
max_job_failures: 3
env:
  # Let GPU allocations overflow into the Grace CPU's coherent memory.
  GGML_CUDA_ENABLE_UNIFIED_MEMORY: "1"
inputs:
  - name: cache
    label: Weight cache
    type: path
    default: "{{cluster.cache}}"
    required: true
    help: LLAMA_CACHE. Node-local scratch is fastest.
  - name: image
    label: Container image
    type: path
    default: "{{cluster.image.llamacpp}}"
    help: Leave empty to run the llama-server on the node's PATH.
  - name: context
    label: Context length
    type: choice
    options: [131072, 262144, 524288, 1048576]
    default: 1048576
  - name: parallel
    label: Requests at once
    type: number
    min: 1
    max: 16
    default: 4
  - name: cpu_moe
    label: MoE layers in Grace memory
    type: number
    min: 0
    max: 92
    default: 68
---
#!/bin/bash -l
#SBATCH --gres=gpu:1                 # one GH200 superchip
#SBATCH --cpus-per-task=72
#SBATCH --mem=560G
set -euo pipefail
{{cluster.setup}}
export LLAMA_CACHE={{cache}}
IMAGE="{{image}}"
if [ -n "$IMAGE" ]; then RUN=(apptainer exec --nv --bind {{cache}} "$IMAGE"); else RUN=(); fi
"${RUN[@]}" llama-server -hf unsloth/GLM-5.2-GGUF:UD-IQ2_M \
  --host 0.0.0.0 --port "$OBLETH_SERVING_PORT" --alias {{api_model_name}} \
  -ngl 99 --ctx-size {{context}} --parallel {{parallel}} --threads "$(nproc)" \
  --n-cpu-moe {{cpu_moe}} \
  --batch-size 2048 --ubatch-size 512 \
  --cache-type-k q8_0 --cache-type-v q8_0 \
  --temp 1.0 --top-p 0.95 --min-p 0.01 \
  --cont-batching --flash-attn on --jinja
