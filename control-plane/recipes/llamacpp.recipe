---
name: llama.cpp
description: "Any GGUF model with llama-server, fetched from Hugging Face. Runs a native llama-server on the node's PATH, or one in a container image."
engine: llamacpp
kind: engine
requires: "A llama-server built for the node's CPU and GPU, in a container image or on the node's PATH"
model_type: chat
api_model_name: my-model
port: 8000
health_path: /health
target_replicas: 1
max_job_failures: 2
tested:
  - hardware: "1× A100 80 GB"
    engine: "llama.cpp (server-cuda image of 2026-10-03)"
    date: 2026-10-03
    result: "Served unsloth/Qwen3.5-9B-GGUF:Q4_K_M with --reasoning-budget 0. Ready 20 seconds after the job started, with the file already downloaded. One request ran at about 115 tokens a second; 16 at once reached 280."
  - hardware: "1× GH200 96 GB"
    engine: "llama.cpp (server-cuda image of 2026-10-03, Arm)"
    date: 2026-10-03
    result: "Served unsloth/Qwen3.5-9B-GGUF:Q4_K_M with --reasoning-budget 0. Ready in 40 seconds. The first answer took half a minute while the engine warmed up; after that, about 200 tokens a second for one request and 500 across 16."
inputs:
  - name: model
    label: GGUF on Hugging Face
    type: text
    required: true
    help: The repo and quantization, such as unsloth/Qwen3-32B-GGUF:Q4_K_M.
  - name: context
    label: Context length
    type: number
    min: 1024
    default: 32768
    required: true
    unit: tokens
    help: The longest prompt and answer together, shared by the requests running at once. A longer context needs more memory.
  - name: parallel
    label: Requests at once
    type: number
    min: 1
    max: 64
    default: 4
  - name: extra
    label: More llama-server flags
    type: text
    help: "Anything else to pass to llama-server, written as on its command line, such as --n-cpu-moe 60 to keep MoE experts in CPU memory."
  - name: image
    label: Container image
    type: path
    default: "{{cluster.image.llamacpp}}"
    help: The image the server runs in. Leave it empty to run llama-server from the node's PATH, for example after the cluster's setup lines load it.
  - name: cache
    label: Weight cache
    type: path
    default: "{{cluster.cache}}"
    required: true
    help: Where the weights are kept between jobs. Use shared storage, so a restart on another node doesn't download them again.
---
#!/bin/bash -l
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
# The cluster's setup lines run before strict mode, since site scripts often
# read unset variables.
{{cluster.setup}}
set -euo pipefail
export LLAMA_CACHE="{{cache}}"
# The official image keeps llama-server and its libraries in /app, which
# neither PATH nor the library path includes when it runs this way.
# In the image when one is set, with the cluster's container command
# (OBLETH_CONTAINER_RUN, "apptainer exec --nv" when unset); else from the node's PATH.
IMAGE="{{image}}"
RUN=()
if [ -n "$IMAGE" ]; then
  read -r -a RUN <<< "${OBLETH_CONTAINER_RUN:-apptainer exec --nv}"
  RUN+=(--bind "$LLAMA_CACHE" "$IMAGE" sh -c 'PATH=/app:$PATH LD_LIBRARY_PATH=/app:${LD_LIBRARY_PATH:-} exec "$0" "$@"')
fi
exec ${RUN[@]+"${RUN[@]}"} llama-server -hf {{model}} \
  --alias {{api_model_name}} \
  --host 0.0.0.0 --port "$OBLETH_SERVING_PORT" \
  -ngl 99 --ctx-size {{context}} --parallel {{parallel}} --threads "$(nproc)" \
  --cont-batching --flash-attn on --jinja \
  {{extra}}
