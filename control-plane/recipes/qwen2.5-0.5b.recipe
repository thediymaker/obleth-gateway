---
name: Qwen2.5 0.5B (Ollama smoke test)
description: "A tiny model to check that launching works end to end: the job starts, pulls the model and serves it in a minute or two."
engine: ollama
kind: model
model: qwen2.5:0.5b
model_type: chat
api_model_name: qwen2.5:0.5b
port: 8000
health_path: /api/tags
target_replicas: 1
max_job_failures: 0
inputs:
  - name: image
    label: Container image
    type: path
    default: "{{cluster.image.ollama}}"
    required: true
---
#!/bin/bash -l
#SBATCH --nodes=1
set -euo pipefail
{{cluster.setup}}
apptainer exec --nv {{image}} \
  sh -c "OLLAMA_HOST=0.0.0.0:${OBLETH_SERVING_PORT} ollama serve & sleep 5 && OLLAMA_HOST=0.0.0.0:${OBLETH_SERVING_PORT} ollama pull qwen2.5:0.5b && wait"
