---
name: Qwen2.5 0.5B (Ollama)
description: Qwen2.5 0.5B served via Ollama from /scratch/ollama.sif; weights pulled to the node at launch.
engine: ollama
model_type: chat
api_model_name: qwen2.5:0.5b
port: 8000
health_path: /api/tags
target_replicas: 1
max_job_failures: 0
---
#!/bin/bash -l
#SBATCH --partition=DaCluster
#SBATCH --nodes=1
#SBATCH --output=logs/qwen2.5-0.5b-%j.out
# Recipes submit this script verbatim; ollama lives in the apptainer image, so
# wrap the launch in `apptainer exec` (the legacy `image` field does not apply
# to recipe script bodies).
apptainer exec --nv /scratch/ollama.sif \
  sh -c "OLLAMA_HOST=0.0.0.0:8000 ollama serve & sleep 5 && OLLAMA_HOST=0.0.0.0:8000 ollama pull qwen2.5:0.5b && wait"
