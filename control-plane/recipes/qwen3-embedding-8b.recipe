---
name: Qwen3 Embedding 8B
description: "Text embeddings for search and retrieval, 4096 dimensions, in over 100 languages. One GPU with 24 GB or more."
engine: vllm
kind: model
model: Qwen/Qwen3-Embedding-8B
weights_gb: 15
requires: "vLLM 0.11.0 or later"
model_type: embedding
api_model_name: qwen3-embedding-8b
port: 8000
health_path: /health
target_replicas: 1
max_job_failures: 2
env:
  # The first start downloads the weights; don't let vLLM give up while it loads.
  VLLM_ENGINE_READY_TIMEOUT_S: "3600"
tested:
  - hardware: "1× A100 80 GB"
    engine: "vLLM 0.30.1rc1 (nightly)"
    date: 2026-10-03
    result: "Ready in 3 minutes. Returned 4,096-dimension embeddings that ranked related texts above unrelated ones."
inputs:
  - name: context
    label: Longest input
    type: choice
    options: [8192, 32768]
    default: 32768
    unit: tokens
  - name: extra
    label: More vLLM flags
    type: text
    help: "Anything else to pass to vllm serve, written as on its command line, such as --gpu-memory-utilization 0.85 on a GPU shared with other work."
  - name: image
    label: Container image
    type: path
    default: "{{cluster.image.vllm}}"
    help: The image the server runs in. Leave it empty to run vllm from the node's PATH, for example after the cluster's setup lines load it.
  - name: cache
    label: Weight cache
    type: path
    default: "{{cluster.cache}}"
    required: true
    help: Where the weights are kept between jobs. Use shared storage, so a restart on another node doesn't download them again.
---
#!/bin/bash -l
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
# The cluster's setup lines run before strict mode, since site scripts often
# read unset variables.
{{cluster.setup}}
set -euo pipefail
export HF_HOME="{{cache}}"
# In the image when one is set, with the cluster's container command
# (OBLETH_CONTAINER_RUN, "apptainer exec --nv" when unset); else from the node's PATH.
IMAGE="{{image}}"
RUN=()
if [ -n "$IMAGE" ]; then
  read -r -a RUN <<< "${OBLETH_CONTAINER_RUN:-apptainer exec --nv}"
  RUN+=(--bind "$HF_HOME" "$IMAGE")
fi
exec ${RUN[@]+"${RUN[@]}"} vllm serve Qwen/Qwen3-Embedding-8B \
  --served-model-name {{api_model_name}} \
  --host 0.0.0.0 --port "$OBLETH_SERVING_PORT" \
  --tensor-parallel-size "${SLURM_GPUS_ON_NODE:-1}" \
  --runner pooling \
  --max-model-len {{context}} \
  {{extra}}
