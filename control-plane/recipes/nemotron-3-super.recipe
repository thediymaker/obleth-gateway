---
name: Nemotron 3 Super 120B-A12B (NVFP4)
description: "NVIDIA's 120B hybrid Mamba and mixture-of-experts model, 12B active, in NVFP4. One GPU with 96 GB or more holds it; NVFP4 runs on Hopper as well as Blackwell. Tool calling and reasoning."
engine: vllm
kind: model
model: nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
weights_gb: 80
requires: "vLLM 0.17.1 or later"
model_type: chat
api_model_name: nemotron-3-super
port: 8000
health_path: /health
target_replicas: 1
max_job_failures: 2
env:
  VLLM_ENGINE_READY_TIMEOUT_S: "3600"
tested:
  - hardware: "1× GH200 96 GB"
    engine: "vLLM 0.30.1rc1 (nightly, Arm)"
    date: 2026-10-03
    result: "Ready in 6 minutes. One request ran at about 135 tokens a second; 16 at once reached 850. Tool calls worked 3 times out of 3."
inputs:
  - name: context
    label: Context length
    type: choice
    options: [32768, 131072, 262144]
    default: 131072
  - name: seqs
    label: Requests at once
    type: number
    min: 1
    max: 1024
    default: 256
    help: Each request in flight holds one Mamba state. With the weights on a 96 GB GPU there is room for about 380.
  - name: tools
    label: Tool calling
    type: flag
    default: true
    adds: --enable-auto-tool-choice --tool-call-parser qwen3_xml
    capabilities: [function_calling, tool_choice]
  - name: reasoning
    label: Reasoning
    type: flag
    default: true
    adds: --reasoning-parser nemotron_v3
  - name: image
    label: Container image
    type: path
    default: "{{cluster.image.vllm}}"
    required: true
  - name: cache
    label: Weight cache
    type: path
    default: "{{cluster.cache}}"
    required: true
    help: HF_HOME, where the weights are kept between jobs.
---
#!/bin/bash -l
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=16
#SBATCH --mem=120G
set -euo pipefail
{{cluster.setup}}
export HF_HOME={{cache}}
apptainer exec --nv --bind {{cache}} {{image}} \
  vllm serve nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4 \
    --served-model-name {{api_model_name}} \
    --host 0.0.0.0 --port "$OBLETH_SERVING_PORT" \
    --trust-remote-code \
    --kv-cache-dtype fp8 \
    --max-model-len {{context}} \
    --max-num-seqs {{seqs}} \
    {{tools}} {{reasoning}}
