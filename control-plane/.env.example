# Copy to .env.local for local development (npm run dev):
#   cp .env.example .env.local
#
# Next.js loads .env.local automatically. This file is safe to commit; never commit .env.local.

# obleth Management API (server-side only — not exposed to the browser)
# OBLETH_ADMIN_TOKEN is REQUIRED; the value below is a DEV EXAMPLE only.
OBLETH_ADMIN_BASE_URL=http://localhost:9180
OBLETH_ADMIN_TOKEN=dev-admin-token

# Dashboard sign-in (control plane UI). DASHBOARD_ADMIN_EMAIL and a password are
# REQUIRED — the dashboard refuses to start otherwise. Values below are DEV
# EXAMPLES only; change them before deploying.
#
# Dashboard sign-in is email + password. DASHBOARD_ADMIN_EMAIL must be a real
# email address — a bare username is not accepted. DASHBOARD_PASSWORD must be
# at least 8 characters; a shorter value causes the admin seed to fail silently.
#
# Upgrading from an install that used a bare username: set DASHBOARD_ADMIN_EMAIL
# to a real email and ensure DASHBOARD_PASSWORD is ≥8 characters, then start
# the upgraded control plane — the admin account is created on first boot.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=obleth-admin
# Prefer a bcrypt hash in production instead of DASHBOARD_PASSWORD:
# DASHBOARD_PASSWORD_HASH=

# Session cookie signing secret. MUST be at least 32 characters or the dashboard
# fails closed. Generate one with `openssl rand -hex 32`.
DASHBOARD_SESSION_SECRET=dev-session-secret-change-in-production-1234

# ---- Auth DB + OIDC (better-auth / SSO) ------------------------------------
# Postgres connection URL for the auth tables (user, session, account). Points at
# the SAME database the gateway uses — the auth `user.tenantId` FK references the
# `tenants` table there. REQUIRED for sign-in to work.
DATABASE_URL=postgres://obleth:obleth@localhost:5432/obleth

# Secret used to sign session tokens (better-auth). Must match DASHBOARD_SESSION_SECRET
# so you only need one secret — just set both to the same value.
BETTER_AUTH_SECRET=dev-session-secret-change-in-production-1234

# External base URL of the dashboard. Used for OIDC redirect URIs and email links.
# For local dev with `npm run dev` on port 3000:
BETTER_AUTH_URL=http://localhost:3000

# Break-glass admin account seeded on first boot (using DASHBOARD_PASSWORD above).
# Change this to a real address before deploying; it receives password-reset emails.
DASHBOARD_ADMIN_EMAIL=admin@example.com

# JSON array of OIDC providers. Leave empty (or unset) to disable SSO — the
# local username/password form is always available regardless.
# Example using a local Dex dev IdP (run `docker compose --profile sso-dev up`):
# OIDC_PROVIDERS=[{"providerId":"dex","displayName":"Dev SSO (Dex)","discoveryUrl":"http://localhost:5556/dex/.well-known/openid-configuration","clientId":"obleth-control-plane","clientSecret":"dev-dex-secret","scopes":["openid","email","profile"]}]
OIDC_PROVIDERS=
