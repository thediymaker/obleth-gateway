<?xml version="1.0"?>
<!--
  Bounds ClickHouse's own logs. The stock image logs at trace and keeps its
  system log tables (query_log, part_log, metric_log, text_log, ...) forever,
  which on a busy gateway outgrows the usage ledger many times over. Each
  table below is partitioned by day and drops days older than 7; text_log
  keeps warnings and errors. Mounted into the server's config.d so it merges
  with the shipped config. The Helm chart renders the same settings from
  clickhouse.systemLogRetentionDays, clickhouse.logLevel, clickhouse.metricLog
  and clickhouse.memoryRatio.

  metric_log is removed: it snapshots about 1,000 counters once a second, and
  merging such parts holds a buffer per column, about 4 GiB on this image.
  Nothing in Obleth reads it. The server also caps its own memory at 0.75 of
  what the container (or host) has, instead of the image's 0.9, so an
  oversized merge fails inside ClickHouse rather than getting the container
  killed.
-->
<clickhouse>
    <logger>
        <level>information</level>
    </logger>
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>
    <query_log>
        <partition_by>event_date</partition_by>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <settings>ttl_only_drop_parts = 1</settings>
    </query_log>
    <query_thread_log>
        <partition_by>event_date</partition_by>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <settings>ttl_only_drop_parts = 1</settings>
    </query_thread_log>
    <query_views_log>
        <partition_by>event_date</partition_by>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <settings>ttl_only_drop_parts = 1</settings>
    </query_views_log>
    <part_log>
        <partition_by>event_date</partition_by>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <settings>ttl_only_drop_parts = 1</settings>
    </part_log>
    <trace_log>
        <partition_by>event_date</partition_by>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <settings>ttl_only_drop_parts = 1</settings>
    </trace_log>
    <text_log>
        <partition_by>event_date</partition_by>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <settings>ttl_only_drop_parts = 1</settings>
        <level>warning</level>
    </text_log>
    <metric_log remove="remove"/>
    <error_log>
        <partition_by>event_date</partition_by>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <settings>ttl_only_drop_parts = 1</settings>
    </error_log>
    <asynchronous_metric_log>
        <partition_by>event_date</partition_by>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <settings>ttl_only_drop_parts = 1</settings>
    </asynchronous_metric_log>
    <processors_profile_log>
        <partition_by>event_date</partition_by>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <settings>ttl_only_drop_parts = 1</settings>
    </processors_profile_log>
    <backup_log>
        <partition_by>event_date</partition_by>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
        <settings>ttl_only_drop_parts = 1</settings>
    </backup_log>
</clickhouse>
