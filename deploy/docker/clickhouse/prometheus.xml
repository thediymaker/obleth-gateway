<?xml version="1.0"?>
<!--
  Enables ClickHouse's built-in Prometheus exposition endpoint on :9363/metrics.
  Mounted into the server's config.d so it merges with the shipped config.
  Scraped by the observability-profile Prometheus (see ../prometheus.yml).
-->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
        <status_info>true</status_info>
    </prometheus>
</clickhouse>
