# Copy to .env in this directory for Docker Compose:
#   cp .env.example .env
#
# Compose loads deploy/docker/.env automatically for ${VAR} substitution and env_file.

# ---- Profiles -------------------------------------------------------------
# Core services (postgres, redis, clickhouse, obleth, control-plane) always run.
# Optional services are gated behind profiles:
#   benchmark     -> GPU-free benchmark fixture backend
#   mock          -> legacy alias for the benchmark profile
#   edge          -> HAProxy front door (use a managed LB in production)
#   observability -> Prometheus + Grafana + Jaeger (OTLP traces)
#
# Default the full dev/demo stack on with a single `docker compose up`:
COMPOSE_PROFILES=benchmark,edge,observability
# For a lean production-style run, leave COMPOSE_PROFILES empty and point obleth
# at a real upstream below.

# ---- Release version --------------------------------------------------------
# Image tag for the first-party services (obleth, control-plane,
# benchmark-backend), published to ghcr.io/thediymaker/obleth-gateway by the
# release workflow. Pin a release for reproducible deploys; `latest` tracks the
# newest stable release, `main` tracks unreleased edge builds. Developers
# building from source (`docker compose up --build`) can ignore this.
# OBLETH_VERSION=v0.2.0

# ---- Datastore credentials ------------------------------------------------
# Used by the bundled postgres/clickhouse containers AND composed into obleth's
# connection URLs. Compose requires the passwords to be set (it errors out if
# they are empty). The values below are DEV EXAMPLES — change them before any
# real deployment.
POSTGRES_USER=obleth
POSTGRES_PASSWORD=obleth
POSTGRES_DB=obleth
CLICKHOUSE_USER=obleth
CLICKHOUSE_PASSWORD=obleth
CLICKHOUSE_DB=obleth

# ---- Gateway --------------------------------------------------------------
# Upstream LLM endpoint. Defaults to the benchmark fixture backend; set to a real
# vLLM/Aibrix endpoint when running without the `benchmark` profile.
# OBLETH_UPSTREAM_BASE_URL=http://benchmark-backend:8081

# Management API token (shared by the obleth service and the control-plane).
# REQUIRED: compose errors out if unset. The value below is a throwaway DEV
# EXAMPLE only — generate a strong random token for any real deployment, e.g.
# `openssl rand -hex 32`.
OBLETH_ADMIN_TOKEN=dev-admin-token

# Encryption key for upstream secrets at rest (model provider api_key and MCP
# auth_header are AES-256-GCM encrypted in Postgres). Must be base64 of 32 random
# bytes: `openssl rand -base64 32`. If unset, those columns are stored in
# PLAINTEXT (a warning is logged) — set this for any real deployment.
# OBLETH_ENCRYPTION_KEY=

# SSRF allowlist for admin-registered upstreams (model api_base, MCP upstream_url).
# obleth is local-first: private/LAN/loopback (RFC1918, 127.0.0.0/8, CGNAT,
# IPv6 unique-local) targets are ALLOWED BY DEFAULT. Cloud-metadata/link-local
# (169.254.0.0/16, fe80::/10) stays blocked.
#
# To harden a deployment that forwards to untrusted upstreams, set
# OBLETH_BLOCK_PRIVATE_NETWORKS=1 to reject all private targets unless their
# exact range is listed here:
# OBLETH_ALLOWED_PRIVATE_CIDRS=10.0.0.0/8,192.168.0.0/16

# Optional server-side pepper mixed into API-key hashes (defense-in-depth if the
# config DB leaks). Keep it secret and stable; changing it invalidates all issued
# keys. `openssl rand -hex 32`.
# OBLETH_API_KEY_PEPPER=

# Admission control on backpressure. Default `true` (fail-open) is the intended
# self-hosted behavior: if Redis is unavailable, requests are admitted rather
# than dropped. For multi-tenant/cloud deployments where quota enforcement must
# never be bypassed, set this to `false` (fail-closed).
OBLETH_FAIL_OPEN=true

# OTLP/HTTP trace endpoint (base URL; obleth posts to {url}/v1/traces). Empty
# disables tracing. With the observability profile, point it at bundled Jaeger:
# OBLETH_OTEL_ENDPOINT=http://jaeger:4318

# Slack incoming-webhook alerts for gateway issues. The webhook URL is a secret;
# never commit a real value.
# OBLETH_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
OBLETH_SLACK_ALERT_MIN_INTERVAL_SECS=300

# Model health: passive ClickHouse signal first, then token-free GET {api_base}/models
# liveness probes directly at each upstream.
OBLETH_MODEL_HEALTH_ENABLED=true
OBLETH_MODEL_HEALTH_INTERVAL_SECS=900
OBLETH_MODEL_HEALTH_TIMEOUT_SECS=30
OBLETH_MODEL_HEALTH_RETENTION_DAYS=30

# Days of raw per-request usage history kept before pruning. The permanent
# daily rollup (usage_daily) is kept forever regardless of this value.
OBLETH_USAGE_RETENTION_DAYS=180

# ---- Observability (profile: observability / edge) ------------------------
# Grafana admin login. Anonymous access is disabled, so a password is REQUIRED
# (compose errors out if unset). DEV EXAMPLE — change it for any real deploy.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=obleth
# HAProxy /stats UI credentials (the :8404 frontend is in-network only, but the
# stats page is password-protected as defense-in-depth). DEV EXAMPLES.
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=obleth

# ---- Control plane dashboard auth ----------------------------------------
# All three are REQUIRED (the dashboard refuses to start otherwise). The values
# below are DEV EXAMPLES only — change them for any real deployment.
DASHBOARD_USERNAME=admin
# Prefer a bcrypt hash via DASHBOARD_PASSWORD_HASH over a plaintext password.
# Generate one with: `npx bcrypt-cli hash 'your-password' 12`
# DASHBOARD_PASSWORD_HASH=
DASHBOARD_PASSWORD=obleth
# Session cookie signing secret. MUST be at least 32 characters; the dashboard
# fails closed if it is missing or too short. Generate with `openssl rand -hex 32`.
DASHBOARD_SESSION_SECRET=dev-session-secret-change-in-production-1234
