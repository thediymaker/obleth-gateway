# Copy to .env in this directory for Docker Compose:
#   cp .env.example .env
#
# Compose loads deploy/docker/.env automatically for ${VAR} substitution and env_file.

# ---- Profiles -------------------------------------------------------------
# Core services (postgres, redis, clickhouse, obleth, control-plane) always run.
# Optional services are gated behind profiles. Opt in by listing them here in
# COMPOSE_PROFILES (config) — then a single `docker compose up -d --build` (run
# from this directory) builds and starts them. No --profile flag needed.
#   benchmark     -> GPU-free benchmark fixture backend
#   mock          -> legacy alias for the benchmark profile
#   edge          -> HAProxy front door (use a managed LB in production)
#   observability -> Prometheus + Grafana + Jaeger (OTLP traces)
#   slurm         -> obleth-provisioner (keeps managed models alive on Slurm)
#   compressor      -> neural prose compression sidecar (bakes ~600 MB ONNX model)
#
# Default the full dev/demo stack on with a single `docker compose up`:
COMPOSE_PROFILES=benchmark,edge,observability
# Add `slurm` here (e.g. benchmark,edge,observability,slurm) to include the Slurm
# provisioner in the same one-command up/down. Remove it to leave Slurm out.
# For a lean production-style run, leave COMPOSE_PROFILES empty and point obleth
# at a real upstream below.

# ---- Release version --------------------------------------------------------
# Image tag for the first-party services (obleth, control-plane,
# benchmark-backend), published to ghcr.io/thediymaker/obleth-gateway by the
# release workflow. Pin a release for reproducible deploys; `latest` tracks the
# newest stable release, `main` tracks unreleased edge builds. Developers
# building from source (`docker compose up --build`) can ignore this.
# OBLETH_VERSION=v0.2.0

# ---- Datastore credentials ------------------------------------------------
# Used by the bundled postgres/clickhouse containers AND composed into obleth's
# connection URLs. Compose requires the passwords to be set (it errors out if
# they are empty). The values below are DEV EXAMPLES — change them before any
# real deployment.
POSTGRES_USER=obleth
POSTGRES_PASSWORD=obleth
POSTGRES_DB=obleth
CLICKHOUSE_USER=obleth
CLICKHOUSE_PASSWORD=obleth
CLICKHOUSE_DB=obleth

# ---- Gateway --------------------------------------------------------------
# Upstream LLM endpoint. Defaults to the benchmark fixture backend; set to a real
# vLLM/Aibrix endpoint when running without the `benchmark` profile.
# OBLETH_UPSTREAM_BASE_URL=http://benchmark-backend:8081

# Management API token (shared by the obleth service and the control-plane).
# REQUIRED: compose errors out if unset. The value below is a throwaway DEV
# EXAMPLE only — generate a strong random token for any real deployment, e.g.
# `openssl rand -hex 32`.
OBLETH_ADMIN_TOKEN=dev-admin-token

# Encryption key for upstream secrets at rest (model provider api_key and MCP
# auth_header are AES-256-GCM encrypted in Postgres). Must be base64 of 32 random
# bytes: `openssl rand -base64 32`. If unset, those columns are stored in
# PLAINTEXT (a warning is logged) — set this for any real deployment.
# OBLETH_ENCRYPTION_KEY=

# SSRF allowlist for admin-registered upstreams (model api_base, MCP upstream_url).
# obleth is local-first: private/LAN/loopback (RFC1918, 127.0.0.0/8, CGNAT,
# IPv6 unique-local) targets are ALLOWED BY DEFAULT. Cloud-metadata/link-local
# (169.254.0.0/16, fe80::/10) stays blocked.
#
# To harden a deployment that forwards to untrusted upstreams, set
# OBLETH_BLOCK_PRIVATE_NETWORKS=1 to reject all private targets unless their
# exact range is listed here:
# OBLETH_ALLOWED_PRIVATE_CIDRS=10.0.0.0/8,192.168.0.0/16

# Optional server-side pepper mixed into API-key hashes (defense-in-depth if the
# config DB leaks). Keep it secret and stable; changing it invalidates all issued
# keys. `openssl rand -hex 32`.
# OBLETH_API_KEY_PEPPER=

# Admission control on backpressure. Default `true` (fail-open) is the intended
# self-hosted behavior: if Redis is unavailable, requests are admitted rather
# than dropped. For multi-tenant/cloud deployments where quota enforcement must
# never be bypassed, set this to `false` (fail-closed).
OBLETH_FAIL_OPEN=true

# OTLP/HTTP trace endpoint (base URL; obleth posts to {url}/v1/traces). Empty
# disables tracing. With the observability profile, point it at bundled Jaeger:
# OBLETH_OTEL_ENDPOINT=http://jaeger:4318

# Slack incoming-webhook alerts for gateway issues. The webhook URL is a secret;
# never commit a real value.
# OBLETH_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
OBLETH_SLACK_ALERT_MIN_INTERVAL_SECS=300

# Model health: passive ClickHouse signal first, then token-free GET {api_base}/models
# liveness probes directly at each upstream.
OBLETH_MODEL_HEALTH_ENABLED=true
OBLETH_MODEL_HEALTH_INTERVAL_SECS=900
OBLETH_MODEL_HEALTH_TIMEOUT_SECS=30
OBLETH_MODEL_HEALTH_RETENTION_DAYS=30

# Days of raw per-request usage history kept before pruning. The permanent
# daily rollup (usage_daily) is kept forever regardless of this value.
OBLETH_USAGE_RETENTION_DAYS=180

# ---- Neural compression sidecar (profile: compressor) ----------------------
# Optional Python+ONNX sidecar that scores responses for extractive prose
# compression. The feature is OFF when OBLETH_COMPRESSOR_URL is empty (default).
# To enable: add `compressor` to COMPOSE_PROFILES above, then set the URL below.
# OBLETH_COMPRESSOR_URL=http://compressor:8080
# OBLETH_COMPRESSOR_TIMEOUT_MS=800
#
# Which model the sidecar bakes at BUILD time (change these, then rebuild the
# compressor image). Default: kompress-v2-base via its pre-built ONNX. For
# LLMLingua-2 (better filler/substance discrimination), export it instead:
# COMPRESSOR_SOURCE=export
# COMPRESSOR_MODEL_ID=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank
# COMPRESSOR_ONNX_FILE=onnx/kompress-fp32.onnx   # only used when COMPRESSOR_SOURCE=onnx

# ---- Slurm provisioner (profile: slurm) -----------------------------------
# Optional plugin that keeps managed models alive on a preemptible Slurm cluster
# via slurmrestd. Opt in by adding `slurm` to COMPOSE_PROFILES at the top of this
# file; it then builds and starts with the same one command as the rest of the
# stack:
#   docker compose up -d --build          # run from deploy/docker/
# The slurmrestd connection details (URL, user, JWT) AND the master enable switch
# are configured in the dashboard: Settings → Slurm (stored encrypted in the DB,
# fetched by the provisioner each tick). The JWT is encrypted at rest with
# OBLETH_ENCRYPTION_KEY — set that above for production. All per-model job
# specifics (partition, GRES, image, launch command, …) are set when you create
# the model. So there are NO Slurm env vars to set here: the provisioner only
# needs OBLETH_ADMIN_TOKEN (above) to reach the Management API.
#
# Local dev only: if the gateway/provisioner containers cannot resolve or route
# to your cluster node hostnames, add a gitignored docker-compose.override.yml in
# this directory with `extra_hosts` for the nodes (on BOTH the obleth and
# obleth-provisioner services). It auto-merges into the one command above.
#
# Self-heal: a healthy replica whose Slurm job still reports RUNNING but whose
# health probe has been failing for this many net ticks (a "zombie" job) is
# restarted automatically, at most one per model per tick. The counter decays
# on a passing probe, so brief flaps on a busy server don't accumulate; 20
# ticks at the default 15s interval is ~5 minutes of sustained failure.
# 0 disables self-heal.
# OBLETH_PROVISIONER_RESTART_AFTER_FAILURES=20

# ---- Observability (profile: observability / edge) ------------------------
# Grafana admin login. Anonymous access is disabled, so a password is REQUIRED
# (compose errors out if unset). DEV EXAMPLE — change it for any real deploy.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=obleth
# HAProxy /stats UI credentials (the :8404 frontend is in-network only, but the
# stats page is password-protected as defense-in-depth). DEV EXAMPLES.
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=obleth

# ---- Control plane dashboard auth ----------------------------------------
# All three are REQUIRED (the dashboard refuses to start otherwise). The values
# below are DEV EXAMPLES only — change them for any real deployment.
#
# Dashboard sign-in is email + password. DASHBOARD_ADMIN_EMAIL must be a real
# email address (e.g. admin@example.com) — a bare username is not accepted.
# DASHBOARD_PASSWORD must be at least 8 characters; a shorter value causes the
# admin seed to fail silently (no admin account is created).
#
# Upgrading from an install that used a bare username: set DASHBOARD_ADMIN_EMAIL
# to a real email and ensure DASHBOARD_PASSWORD is ≥8 characters, then start
# the upgraded control plane — the admin account is created on first boot.
# Prefer a bcrypt hash via DASHBOARD_PASSWORD_HASH over a plaintext password.
# Generate one with: `npx bcrypt-cli hash 'your-password' 12`
# DASHBOARD_PASSWORD_HASH=
DASHBOARD_PASSWORD=obleth-admin
# Break-glass admin email seeded on first boot (paired with the password above).
DASHBOARD_ADMIN_EMAIL=admin@example.com
# Session cookie signing secret. MUST be at least 32 characters; the dashboard
# fails closed if it is missing or too short. Generate with `openssl rand -hex 32`.
DASHBOARD_SESSION_SECRET=dev-session-secret-change-in-production-1234

# ---- Accessing the dashboard from another machine (not localhost) ----
# better-auth checks the browser's Origin header against BETTER_AUTH_URL on every
# login. If you browse to the dashboard by LAN IP or hostname, that Origin won't
# match the localhost default and login is rejected with an invalid-origin error.
# Fix it with EITHER of these:
#   1. Point BETTER_AUTH_URL at the exact URL you browse to (single host):
# BETTER_AUTH_URL=http://192.168.1.50:3002
#   2. Or list extra allowed origins (comma-separated) — handles several hosts
#      without changing baseURL. "*" trusts all origins; only do that on a
#      trusted private network, never on anything internet-reachable:
# TRUSTED_ORIGINS=http://192.168.1.50:3002,http://obleth.lan:3002

# ---- Dashboard SSO (local Dex dev provider; enable with COMPOSE_PROFILES=...,sso-dev) ----
# This file configures the FULLY-DOCKERIZED stack, so the Dex issuer/discoveryUrl below use
# `host.docker.internal` — the one hostname that resolves to Dex from BOTH the browser (via
# Docker Desktop's host entry) and the control-plane container (via the network alias on the
# `dex` service in docker-compose.yml). `localhost` cannot: inside the container it points at
# the container itself, not Dex. The dashboard is published on host :3002, so Dex's redirect
# URI and the default BETTER_AUTH_URL both use :3002 — keep all three in sync if you change ports.
#
# (Running the control plane on the HOST via `npm run dev` instead? Then this file is NOT read —
# put OIDC_PROVIDERS in control-plane/.env.local and use localhost:5556 / port 3000 there.)
#
# OIDC_PROVIDERS is a JSON array consumed by the control plane's better-auth genericOAuth path.
# Uncomment and set this when the sso-dev profile is active:
# OIDC_PROVIDERS=[{"providerId":"dex","displayName":"Dev SSO (Dex)","discoveryUrl":"http://host.docker.internal:5556/dex/.well-known/openid-configuration","clientId":"obleth-control-plane","clientSecret":"dev-dex-secret","scopes":["openid","email","profile"]}]
