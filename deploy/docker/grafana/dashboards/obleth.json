{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "tags": ["obleth"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Obleth Gateway",
  "uid": "obleth-gateway",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Requests / s",
      "datasource": { "type": "prometheus", "uid": "obleth-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } },
      "targets": [{ "refId": "A", "expr": "sum(rate(obleth_requests_total[5m]))" }]
    },
    {
      "type": "stat",
      "title": "Error ratio",
      "datasource": { "type": "prometheus", "uid": "obleth-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] } } },
      "targets": [{ "refId": "A", "expr": "sum(rate(obleth_requests_total{status=~\"4xx|5xx\"}[5m])) / clamp_min(sum(rate(obleth_requests_total[5m])), 1)" }]
    },
    {
      "type": "stat",
      "title": "In flight",
      "datasource": { "type": "prometheus", "uid": "obleth-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } },
      "targets": [{ "refId": "A", "expr": "obleth_in_flight" }]
    },
    {
      "type": "stat",
      "title": "Queue depth",
      "datasource": { "type": "prometheus", "uid": "obleth-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] } } },
      "targets": [{ "refId": "A", "expr": "obleth_queue_depth" }]
    },
    {
      "type": "stat",
      "title": "Cache hit ratio",
      "datasource": { "type": "prometheus", "uid": "obleth-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.2 }, { "color": "green", "value": 0.5 }] } } },
      "targets": [{ "refId": "A", "expr": "sum(rate(obleth_cache_lookups_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(obleth_cache_lookups_total[5m])), 1)" }]
    },
    {
      "type": "stat",
      "title": "Telemetry dropped",
      "datasource": { "type": "prometheus", "uid": "obleth-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [{ "refId": "A", "expr": "obleth_telemetry_dropped" }]
    },
    {
      "type": "timeseries",
      "title": "Request rate by status class",
      "datasource": { "type": "prometheus", "uid": "obleth-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(obleth_requests_total[5m]))", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries",
      "title": "Request rate by admission class",
      "datasource": { "type": "prometheus", "uid": "obleth-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "targets": [{ "refId": "A", "expr": "sum by (admission) (rate(obleth_requests_total[5m]))", "legendFormat": "{{admission}}" }]
    },
    {
      "type": "timeseries",
      "title": "Time to first token (ms)",
      "datasource": { "type": "prometheus", "uid": "obleth-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(obleth_ttft_ms_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(obleth_ttft_ms_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(obleth_ttft_ms_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Total request duration (ms)",
      "datasource": { "type": "prometheus", "uid": "obleth-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(obleth_total_ms_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(obleth_total_ms_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(obleth_total_ms_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Token throughput (tokens/s)",
      "datasource": { "type": "prometheus", "uid": "obleth-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } },
      "targets": [
        { "refId": "A", "expr": "rate(obleth_input_tokens_total[5m])", "legendFormat": "input" },
        { "refId": "B", "expr": "rate(obleth_output_tokens_total[5m])", "legendFormat": "output" },
        { "refId": "C", "expr": "rate(obleth_cache_tokens_saved_total[5m])", "legendFormat": "saved by cache" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache lookups by result",
      "datasource": { "type": "prometheus", "uid": "obleth-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "targets": [{ "refId": "A", "expr": "sum by (result) (rate(obleth_cache_lookups_total[5m]))", "legendFormat": "{{result}}" }]
    },
    {
      "type": "timeseries",
      "title": "MCP gateway requests",
      "datasource": { "type": "prometheus", "uid": "obleth-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "targets": [{ "refId": "A", "expr": "sum by (server, status) (rate(obleth_mcp_requests_total[5m]))", "legendFormat": "{{server}} {{status}}" }]
    }
  ]
}
