# Copy to datastores.env for the standalone external datastores stack:
#   cp datastores.env.example datastores.env
#   docker compose --env-file datastores.env -f datastores.compose.yml up -d
#
# These values back a long-lived Postgres + Redis + ClickHouse tier that an
# external obleth (Helm install with *.enabled=false, or a bare-metal binary)
# connects to. Change every password before any real deployment.

# ---- Bind address ---------------------------------------------------------
# Where the datastore ports are published. 127.0.0.1 (default) keeps them on
# loopback — only an obleth on the SAME host can reach them. To allow an off-box
# obleth, set this to the host's PRIVATE interface IP (e.g. 10.0.0.5) and protect
# it with a firewall / private network. Never bind to a public address.
BIND_ADDR=127.0.0.1

# ---- Postgres -------------------------------------------------------------
POSTGRES_USER=obleth
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=obleth

# ---- ClickHouse -----------------------------------------------------------
CLICKHOUSE_USER=obleth
CLICKHOUSE_PASSWORD=change-me-clickhouse
CLICKHOUSE_DB=obleth
