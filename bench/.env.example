# Copy to bench/.env. The real file is ignored by git.

# Use benchmark-endpoint for the bundled benchmark backend, or set this to any registered model.
MODEL=benchmark-endpoint

# Local compose defaults.
PROXY_BASE=http://localhost
ADMIN_BASE=http://localhost:9090
ADMIN_TOKEN=dev-admin-token

# If MODEL=benchmark-endpoint, this must be reachable from the obleth container.
BENCHMARK_API_BASE=http://benchmark-backend:8081

# Benchmark shape.
CAPACITY=8
DURATION_S=60
CONC=32
OUTPUT_TOKENS=150

# Key lifecycle. Defaults reuse the saved keys and prune older generated bench keys.
BENCH_REUSE_KEYS=1
BENCH_PRUNE_KEYS=1
